{
  "name": "zihanki-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply zihanki-map-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply zihanki-map-db --remote",
    "db:import": "node scripts/import-masters.mjs",
    "db:import:remote": "node scripts/import-masters.mjs --remote"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    },
    "undici@>=7.0.0 <7.30.1": "7.30.1"
  }
}
