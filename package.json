{
  "name": "zihanki-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply zihanki-map-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply zihanki-map-db --remote",
    "db:import": "node scripts/import-masters.mjs",
    "db:import:remote": "node scripts/import-masters.mjs --remote"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.536.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.0.0",
    "wrangler": "^4.126.0"
  }
}
